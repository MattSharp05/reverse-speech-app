# Online play (Supabase Realtime broadcast only: no tables, no SQL, nothing stored).
# Both values are public by design: they ship in the app bundle.
# Set them in Vercel → Project → Settings → Environment Variables, or in .env.local for `pnpm dev`.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
